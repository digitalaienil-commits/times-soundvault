# Server-only authentication configuration. Replace every placeholder locally.
AUTH_PROVIDER=local
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=postgresql://soundvault:soundvault_local@localhost:5432/soundvault

# Google Workspace mode
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_WORKSPACE_DOMAIN=company.example

# Microsoft Entra mode
MICROSOFT_CLIENT_ID=replace-with-microsoft-client-id
MICROSOFT_CLIENT_SECRET=replace-with-microsoft-client-secret
MICROSOFT_TENANT_ID=00000000-0000-0000-0000-000000000000

# Local development and CI users. Local mode is rejected in production.
LOCAL_ADMIN_NAME=Local Admin
LOCAL_ADMIN_EMAIL=admin@soundvault.local
LOCAL_ADMIN_PASSWORD=replace-with-a-strong-local-password
LOCAL_PRODUCER_NAME=Local Music Producer
LOCAL_PRODUCER_EMAIL=producer@soundvault.local
LOCAL_PRODUCER_PASSWORD=replace-with-a-strong-local-password
LOCAL_COORDINATOR_NAME=Local Coordinator
LOCAL_COORDINATOR_EMAIL=coordinator@soundvault.local
LOCAL_COORDINATOR_PASSWORD=replace-with-a-strong-local-password
LOCAL_USER_NAME=Local User
LOCAL_USER_EMAIL=user@soundvault.local
LOCAL_USER_PASSWORD=replace-with-a-strong-local-password

# Private upload storage. Never prefix storage secrets with NEXT_PUBLIC_.
STORAGE_PROVIDER=local
STORAGE_SESSION_ENCRYPTION_KEY=
LOCAL_STORAGE_ROOT=.soundvault-storage
UPLOAD_MAX_FILE_BYTES=2147483648
UPLOAD_MAX_BATCH_BYTES=21474836480
UPLOAD_MAX_TRACKS_PER_BATCH=25
UPLOAD_MAX_STEMS_PER_TRACK=32
UPLOAD_CONCURRENCY=3
UPLOAD_ADVISORY_MAX_DURATION_SECONDS=1800

# Dedicated company SharePoint document library via Microsoft Graph.
ONEDRIVE_TENANT_ID=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_SITE_ID=
ONEDRIVE_DRIVE_ID=
ONEDRIVE_ROOT_ITEM_ID=

# Server-only technical processing. Keep private and outside public/.
PROCESSING_TEMP_ROOT=.soundvault-processing
PROCESSING_CONCURRENCY=2
PROCESSING_FILE_TIMEOUT_MS=600000
PROCESSING_LEASE_MS=300000
PROCESSING_MAX_RETRIES=5
PROCESSING_LEADING_SILENCE_WARNING_MS=2000
PROCESSING_TRAILING_SILENCE_WARNING_MS=3000

# Server-only AI metadata analysis. Never prefix with NEXT_PUBLIC_.
AI_ANALYSIS_ENABLED=true
AI_ANALYSIS_MODEL=gemini-3.5-flash-lite
AI_ANALYSIS_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite
AI_ANALYSIS_TIMEOUT_MS=60000
ESSENTIA_SAMPLE_RATE_HZ=22050
ESSENTIA_MAX_DURATION_SECONDS=180
GEMINI_API_KEY=

# YouTube Content ID integration. Never prefix with NEXT_PUBLIC_.
# Supported providers: manual_youtube | youtube_content_id
COPYRIGHT_PROVIDER=manual_youtube
COPYRIGHT_TEMP_ROOT=.soundvault-copyright
COPYRIGHT_BATCH_MAX_TRACKS=20
COPYRIGHT_BATCH_MAX_DURATION_SECONDS=5400
COPYRIGHT_BATCH_GAP_SECONDS=2
COPYRIGHT_BATCH_ARTIFACT_RETENTION_DAYS=7
COPYRIGHT_BATCH_BUILD_CONCURRENCY=1
COPYRIGHT_JOB_LEASE_MS=300000
COPYRIGHT_BATCH_TIMEOUT_MS=1800000
YOUTUBE_CONTENT_OWNER_ID=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_TEST_CHANNEL_ID=
YOUTUBE_CONTENT_ID_DRY_RUN=true
YOUTUBE_CLAIM_POLL_TIMEOUT_MS=180000
YOUTUBE_CLAIM_POLL_INTERVAL_MS=10000

# Private playback derivatives and delivery packages. Never use NEXT_PUBLIC_.
MEDIA_TEMP_ROOT=.soundvault-media
MEDIA_PROFILE_VERSION=1
MEDIA_PREVIEW_BITRATE_KBPS=192
MEDIA_PREVIEW_SAMPLE_RATE_HZ=48000
MEDIA_WAVEFORM_PEAK_COUNT=2048
MEDIA_JOB_CONCURRENCY=2
MEDIA_JOB_LEASE_MS=300000
MEDIA_JOB_MAX_RETRIES=5
MEDIA_PACKAGE_RETENTION_HOURS=24
MEDIA_PACKAGE_MAX_SOURCE_BYTES=21474836480
MEDIA_PACKAGE_MAX_FILES=40
MEDIA_PACKAGE_BUILD_CONCURRENCY=1
MEDIA_PACKAGE_TIMEOUT_MS=1800000

# Server-only canonical embeddings and semantic search. Never use NEXT_PUBLIC_.
# Supported providers: gemini | simulated
EMBEDDING_PROVIDER=simulated
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_MODEL_VERSION=v1
EMBEDDING_DIMENSION=768
EMBEDDING_JOB_CONCURRENCY=2
EMBEDDING_JOB_LEASE_MS=300000
SEMANTIC_SEARCH_ENABLED=false

# Server-only AI audio generation. Never use NEXT_PUBLIC_.
# Supported providers: google_lyria | elevenlabs | simulated
# GENERATION_DRY_RUN stays true unless it is explicitly set to "false", so a
# misconfigured environment can never bill an external provider.
GENERATION_PROVIDER=simulated
GENERATION_DRY_RUN=true
MAX_GENERATION_DURATION_SECONDS=180
# Only set when ElevenLabs is an approved provider for this deployment.
ELEVENLABS_API_KEY=

# Development only. Extra hostnames allowed to request Next.js dev assets such
# as /_next/hmr. Without this, reaching `next dev` through a tunnel or a LAN
# address loads the HTML but never hydrates, so nothing on the page responds.
# Ignored by `next build`. Comma-separated hostnames, no scheme.
ALLOWED_DEV_ORIGINS=

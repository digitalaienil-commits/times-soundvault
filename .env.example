# Server-only authentication configuration. Replace every placeholder locally.
AUTH_PROVIDER=local
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=postgresql://soundvault:soundvault_local@localhost:5432/soundvault

# Google Workspace mode
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_WORKSPACE_DOMAIN=company.example

# Microsoft Entra mode
MICROSOFT_CLIENT_ID=replace-with-microsoft-client-id
MICROSOFT_CLIENT_SECRET=replace-with-microsoft-client-secret
MICROSOFT_TENANT_ID=00000000-0000-0000-0000-000000000000

# Local development and CI users. Local mode is rejected in production.
LOCAL_ADMIN_NAME=Local Admin
LOCAL_ADMIN_EMAIL=admin@soundvault.local
LOCAL_ADMIN_PASSWORD=replace-with-a-strong-local-password
LOCAL_PRODUCER_NAME=Local Music Producer
LOCAL_PRODUCER_EMAIL=producer@soundvault.local
LOCAL_PRODUCER_PASSWORD=replace-with-a-strong-local-password
LOCAL_COORDINATOR_NAME=Local Coordinator
LOCAL_COORDINATOR_EMAIL=coordinator@soundvault.local
LOCAL_COORDINATOR_PASSWORD=replace-with-a-strong-local-password
LOCAL_USER_NAME=Local User
LOCAL_USER_EMAIL=user@soundvault.local
LOCAL_USER_PASSWORD=replace-with-a-strong-local-password
